# From https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=
# Optional: path to the SQLite database file
DATABASE_PATH=data/bot.db

# AI model as <provider>:<model-id>. Providers: anthropic, openai, google
AI_MODEL=anthropic:claude-opus-5-5
# Set the API key for whichever provider(s) you use
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional per-job overrides, e.g. a cheaper model for reading event pages
# AI_MODEL_EXTRACT=
# AI_MODEL_PLAN=
